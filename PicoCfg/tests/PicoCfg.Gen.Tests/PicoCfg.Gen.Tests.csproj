<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Allow PCFGGEN003 for partial binding test types (ConfigWithStruct) -->
    <NoWarn>$(NoWarn);PCFGGEN003</NoWarn>
    <!-- Generated binding code must compile warning-free under strict policies (BUG-REPORT regression) -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="PicoDI" Condition="'$(UseProjectReferences)' != 'true'" />
    <ProjectReference
      Include="..\..\..\PicoDI\src\PicoDI\PicoDI.csproj"
      Condition="'$(UseProjectReferences)' == 'true'"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PicoCfg\PicoCfg.csproj" />
    <ProjectReference Include="..\..\src\PicoCfg.DI\PicoCfg.DI.csproj" />
    <ProjectReference
      Include="..\..\src\PicoCfg.Gen\PicoCfg.Gen.csproj"
      OutputItemType="Analyzer"
    />
  </ItemGroup>
</Project>
